# Copie para .env e preencha os valores reais
# Nunca envie o .env para o GitHub

# IA — OpenRouter (gratuito): openrouter.ai/keys
FOX_GROQ_API_KEY=sk-or-...
FOX_GROQ_MODEL=meta-llama/llama-3.1-8b-instruct:free
FOX_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
FOX_MAX_TOKENS=512
FOX_TEMP=0.3

# Admin — gerar com: python -c "import secrets; print(secrets.token_hex(32))"
FOX_ADMIN_TOKEN=troque-por-token-aleatorio-seguro

# CORS — domínios permitidos (separados por vírgula)
FOX_ALLOWED_ORIGINS=https://catalogo.redefox.com.br

# E-mail (opcional)
FOX_SMTP_HOST=
FOX_SMTP_PORT=587
FOX_SMTP_USER=
FOX_SMTP_PASS=
FOX_EMAIL_FROM=

# Diretório dos CSVs de estoque (padrão local: ../scraping-estoque/output)
# No Render: /opt/render/project/src/data/estoque
FOX_CSV_DIR=
